generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Bidang {
  id             String           @id @default(uuid())
  nama           String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  singkatan      String?
  kaks           Kak[]
  lhps           Lhp[]
  notaDinas      NotaDinas[]
  suratPengantar SuratPengantar[]
  suratTugas     SuratTugas[]
  suratMasuk     SuratMasuk[]
  users          User[]           @relation("UserBidang")
  pendingUsers   User[]           @relation("UserPendingBidang")
}

model User {
  id            String                 @id @default(uuid())
  email         String                 @unique
  passwordHash  String?
  name          String
  phoneNumber   String?
  role          Role                   @default(PEGAWAI)
  avatarUrl     String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  bidang        String?
  bidangId      String?
  pendingBidangId String?
  status        UserStatus             @default(APPROVED)
  resetRequests PasswordResetRequest[]
  bidangRef     Bidang?                @relation("UserBidang", fields: [bidangId], references: [id])
  pendingBidangRef Bidang?             @relation("UserPendingBidang", fields: [pendingBidangId], references: [id])
}

model PasswordResetRequest {
  id          String        @id @default(uuid())
  userId      String
  email       String
  newPassword String?
  reason      String?
  status      RequestStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SuratTugas {
  id                      String   @id @default(uuid())
  tahun                   String
  noS                     String?
  noST                    String?
  tujuan                  String
  perihal                 String
  tanggalSurat            String?
  tglMulai                String?
  tglSelesai              String?
  suratDiterimaSekretaris String?
  linkDrive               String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  bidangId                String?
  bidang                  Bidang?  @relation(fields: [bidangId], references: [id])
}

model NotaDinas {
  id          String   @id @default(uuid())
  tahun       String
  noND        String?
  yangMeminta String
  tanggalND   String?
  perihal     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bidangId    String?
  bidang      Bidang?  @relation(fields: [bidangId], references: [id])
}

model Lhp {
  id                        String   @id @default(uuid())
  tahun                     String
  noS                       String?
  noLHP                     String?
  tanggalLHP                String?
  tujuan                    String
  perihal                   String
  tanggalDiterimaSekretaris String?
  linkDrive                 String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  bidangId                  String?
  bidang                    Bidang?  @relation(fields: [bidangId], references: [id])
}

model SuratPengantar {
  id            String   @id @default(uuid())
  tahun         String
  tanggalDibuat String?
  noLHP         String?
  tujuan        String
  linkDrive     String?
  bidangId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  bidang        Bidang?  @relation(fields: [bidangId], references: [id])
}

model Kak {
  id            String             @id @default(uuid())
  tahun         String
  tujuan        String
  perihal       String
  diberikanOleh String?
  status        String             @default("Diterima Sekbid")
  linkDrive     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  bidangId      String?
  bidang        Bidang?            @relation(fields: [bidangId], references: [id])
  statusHistory KakStatusHistory[]
}

model KakStatusHistory {
  id         String   @id @default(uuid())
  kakId      String
  status     String
  tanggal    String
  keterangan String?
  diubahOleh String?
  createdAt  DateTime @default(now())
  kak        Kak      @relation(fields: [kakId], references: [id], onDelete: Cascade)
}

model SuratMasuk {
  id                     String   @id @default(uuid())
  tahun                  String   @default("2026")
  noSuratMasuk           String
  tanggalSuratMasuk      String?
  instansiPengirim       String
  perihal                String
  tanggalDiterimaSekbid  String?
  tanggalDikirimKeSekper String?
  linkDrive              String?
  bidangId               String?
  bidang                 Bidang?  @relation(fields: [bidangId], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum Role {
  ADMIN
  PEGAWAI
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}
